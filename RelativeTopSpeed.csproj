<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <MdkInteractive>no</MdkInteractive>
    <LangVersion>6</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16" PrivateAssets="all" />
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.11" PrivateAssets="all" />
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="RelativeTopSpeed/**/*.cs" Exclude="RelativeTopSpeed/bin/**/*.cs;RelativeTopSpeed/obj/**/*.cs" />
    <AdditionalFiles Include="modinfo.sbmi" />
  </ItemGroup>
</Project>
